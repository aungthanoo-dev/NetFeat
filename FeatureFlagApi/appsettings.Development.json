{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RefundDemo": {
    "FailOnRequest": 3
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "ScheduledPaymentProviderRelease",
        "enabled": true,
        "conditions": {
          "client_filters": [{
            "name": "Microsoft.TimeWindow",
            "parameters": {
              "Start": "2030-01-01T12:00:00Z",
              "End": "2030-01-01T13:00:00Z"
            }
          }]
        }
      },
      {
        "id": "CustomerSpecificPaymentRelease",
        "enabled": true,
        "conditions": {
          "client_filters": [{
            "name": "Microsoft.Targeting",
            "parameters": {
              "Audience": {
                "Users": ["customer-001"],
                "Groups": [],
                "DefaultRolloutPercentage": 0
              }
            }
          }]
        }
      },
      {
        "id": "NewPaymentProvider",
        "enabled": false
      },
      {
        "id": "NewPaymentProviderRouting",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.Targeting",
              "parameters": {
                "Audience": {
                  "DefaultRolloutPercentage": 50
                }
              }
            }
          ]
        }
      },
      {
        "id": "RefundsEnabled",
        "enabled": true
      },
      {
        "id": "PaymentRetryExperiment",
        "enabled": true,
        "variants": [
          {
            "name": "NoRetry"
          },
          {
            "name": "RetryOnce"
          }
        ],
        "allocation": {
          "default_when_enabled": "NoRetry",
          "default_when_disabled": "NoRetry",
          "seed": "payment-retry-v1",
          "percentile": [
            {
              "variant": "NoRetry",
              "from": 0,
              "to": 50
            },
            {
              "variant": "RetryOnce",
              "from": 50,
              "to": 100
            }
          ]
        }
      }
    ]
  }
}


