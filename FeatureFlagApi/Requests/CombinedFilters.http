@baseUrl = http://localhost:5159

### Inspect an eligible customer
# All filters must pass: allowlisted customer AND 04:00–06:00 UTC daily AND 20% random chance.
# Outside the window, expect legacy. During it, each evaluation may select either provider.
POST {{baseUrl}}/payments/combined-filter-release
X-Demo-Customer-Id: customer-001
Content-Type: application/json

{"orderId":"combined-single","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-001: ${response.body?.provider}, ${response.body?.status}`);
    client.test("Valid simulated payment", () => {
        client.assert(response.status === 200 && response.body.status === "succeeded", "Expected successful payment");
        client.assert(["new","legacy"].includes(response.body.provider), "Unexpected provider");
    });
%}

### Measure 100 independent evaluations for the same eligible customer
# Approximately 20% only during the active window. No exact-count assertion.
# For daytime testing, temporarily change the daily window to straddle current UTC time,
# restart, run, then restore 04:00–06:00 UTC. There is no request-controlled clock override.
< {%
    request.variables.set("orders", Array.from({length:100}, (_, i) => `combined-${i+1}`));
%}
POST {{baseUrl}}/payments/combined-filter-release
X-Demo-Customer-Id: customer-001
Content-Type: application/json

{"orderId":"{{orders}}","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    const counts = request.iteration() === 0 ? {newProvider:0,legacy:0,failed:0}
        : JSON.parse(client.global.get("combinedCounts"));
    const body = response.body;
    const valid = response.status === 200 && body?.status === "succeeded" && ["new","legacy"].includes(body?.provider);
    if (!valid) counts.failed++;
    else if (body.provider === "new") counts.newProvider++;
    else counts.legacy++;
    client.global.set("combinedCounts", JSON.stringify(counts));
    client.log(`Evaluation ${request.iteration()+1}: HTTP ${response.status}, provider=${body?.provider}`);
    client.test(`Evaluation ${request.iteration()+1} succeeded`, () => client.assert(valid, "Invalid payment response"));
    if (request.iteration() === 99) {
        const validCount = counts.newProvider + counts.legacy;
        const observed = validCount ? (100*counts.newProvider/validCount).toFixed(1)+"%" : "unavailable";
        client.log(`New: ${counts.newProvider}, legacy: ${counts.legacy}, failed: ${counts.failed}`);
        client.log(`Observed new-provider percentage: ${observed}`);
        client.log("Target: 20% of eligible evaluations inside 04:00–06:00 UTC; outside the window all use legacy.");
    }
%}

### Unlisted customer always uses legacy
POST {{baseUrl}}/payments/combined-filter-release
X-Demo-Customer-Id: customer-002
Content-Type: application/json

{"orderId":"combined-unlisted","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-002: ${response.body?.provider}, ${response.body?.status}`);
    client.test("Unlisted customer uses legacy", () => {
        client.assert(response.status === 200 && response.body.provider === "legacy" && response.body.status === "succeeded", "Expected legacy payment");
    });
%}

### Missing customer is rejected
POST {{baseUrl}}/payments/combined-filter-release
Content-Type: application/json

{"orderId":"combined-missing","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.test("Identity is required", () => client.assert(response.status === 400, "Expected 400"));
%}
