@baseUrl = http://localhost:5159

### Selected customer uses new provider
# Edit CustomerSpecificPaymentRelease's Audience.Users in development config,
# restart the API, and rerun. Disabled flag sends everyone to legacy.
# This header is a demo identity; production should use authenticated identity.
POST {{baseUrl}}/payments/customer-release
X-Demo-Customer-Id: customer-001
Content-Type: application/json

{"orderId":"release-001","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-001: provider=${response.body?.provider}, status=${response.body?.status}`);
    client.test("Selected customer uses new provider", () => {
        client.assert(response.status === 200 && response.body.provider === "new" && response.body.status === "succeeded", "Unexpected payment result");
    });
%}

### Other customer uses legacy provider
POST {{baseUrl}}/payments/customer-release
X-Demo-Customer-Id: customer-002
Content-Type: application/json

{"orderId":"release-002","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-002: provider=${response.body?.provider}, status=${response.body?.status}`);
    client.test("Other customer uses legacy", () => {
        client.assert(response.status === 200 && response.body.provider === "legacy" && response.body.status === "succeeded", "Unexpected payment result");
    });
%}

### Missing identity is rejected
POST {{baseUrl}}/payments/customer-release
Content-Type: application/json

{"orderId":"release-003","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`Missing customer header: HTTP ${response.status}`);
    client.test("Customer header is required", () => client.assert(response.status === 400, "Expected HTTP 400"));
%}
