@baseUrl = http://localhost:5159

### Allowlisted customer uses new at any time (when flag enabled)
# OR: targeting OR 04:00–06:00 UTC daily OR 20% random chance.
POST {{baseUrl}}/payments/any-filter-release
X-Demo-Customer-Id: customer-001
Content-Type: application/json

{"orderId":"any-allowlisted","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-001: ${response.body?.provider}, ${response.body?.status}`);
    client.test("Allowlisted customer uses new", () => {
        client.assert(response.status === 200 && response.body.provider === "new" && response.body.status === "succeeded", "Expected new-provider payment with the flag enabled");
    });
%}

### Unlisted customer: new during window, random outside it
POST {{baseUrl}}/payments/any-filter-release
X-Demo-Customer-Id: customer-002
Content-Type: application/json

{"orderId":"any-unlisted","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.log(`customer-002: ${response.body?.provider}, ${response.body?.status}`);
    client.test("Valid unlisted-customer payment", () => {
        client.assert(response.status === 200 && response.body.status === "succeeded" && ["new","legacy"].includes(response.body.provider), "Invalid payment response");
    });
%}

### Measure 100 evaluations for unlisted customer-002
# Inside 04:00–06:00 UTC expect all new; outside expect approximately 20% new.
# No assertion derives server time from the client clock or requires exact random counts.
# To test during daytime, temporarily move the recurring window around current UTC,
# restart, run, then restore 04:00–06:00 UTC. No request-controlled clock override.
< {%
    request.variables.set("orders", Array.from({length:100}, (_, i) => `any-batch-${i+1}`));
%}
POST {{baseUrl}}/payments/any-filter-release
X-Demo-Customer-Id: customer-002
Content-Type: application/json

{"orderId":"{{orders}}","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    const counts = request.iteration() === 0 ? {newProvider:0,legacy:0,failed:0}
        : JSON.parse(client.global.get("anyFilterCounts"));
    const body = response.body;
    const valid = response.status === 200 && body?.status === "succeeded" && ["new","legacy"].includes(body?.provider);
    if (!valid) counts.failed++;
    else if (body.provider === "new") counts.newProvider++;
    else counts.legacy++;
    client.global.set("anyFilterCounts", JSON.stringify(counts));
    client.log(`Evaluation ${request.iteration()+1}: HTTP ${response.status}, provider=${body?.provider}`);
    client.test(`Evaluation ${request.iteration()+1} succeeded`, () => client.assert(valid, "Invalid payment response"));
    if (request.iteration() === 99) {
        const validCount = counts.newProvider + counts.legacy;
        const observed = validCount ? (100*counts.newProvider/validCount).toFixed(1)+"%" : "unavailable";
        client.log(`New: ${counts.newProvider}, legacy: ${counts.legacy}, failed: ${counts.failed}`);
        client.log(`Observed new-provider percentage: ${observed}`);
        client.log("Unlisted customer: all new inside 04:00–06:00 UTC, approximately 20% new outside it (flag enabled).");
    }
%}

### Missing customer is rejected
POST {{baseUrl}}/payments/any-filter-release
Content-Type: application/json

{"orderId":"any-missing","amount":2599,"currency":"USD","paymentMethodToken":"pm_demo_success"}

> {%
    client.test("Identity is required", () => client.assert(response.status === 400, "Expected 400"));
%}
