@baseUrl = http://localhost:5159

### Burst of 100 routing previews with a 20 TPS limit for the new provider
# The API shares a rolling one-second limit across requests to this endpoint.
# Overflow immediately uses legacy; there is no waiting queue or payment charge.
# Wait at least one second between runs to allow previous admissions to expire.
# If all requests arrive within one second with no other traffic: 20 new, 80 legacy.
# Slower runs can admit more than 20 in total as earlier slots expire.
# The limit is per API process, not shared across replicas, and independent of feature flags.
< {%
    request.variables.set("customers", Array.from({ length: 100 }, (_, index) => ({
        id: `customer-${String(index + 1).padStart(3, "0")}`
    })));
%}
POST {{baseUrl}}/payments/tps-routing-preview
X-Demo-Customer-Id: {{$.customers..id}}

> {%
    const counts = request.iteration() === 0
        ? { newProvider: 0, legacy: 0, failed: 0 }
        : JSON.parse(client.global.get("tpsRoutingCounts"));
    const body = response.body;
    const valid = response.status === 200 && (body?.provider === "new" || body?.provider === "legacy");

    if (!valid) {
        counts.failed++;
    } else if (body.provider === "new") {
        counts.newProvider++;
    } else {
        counts.legacy++;
    }
    client.global.set("tpsRoutingCounts", JSON.stringify(counts));

    client.test(`Routing preview ${request.iteration() + 1} succeeded`, () => {
        client.assert(valid, `Unexpected response: HTTP ${response.status}`);
        client.assert(body.reason === (body.provider === "new" ? "capacity-available" : "tps-limit-reached"),
            "Unexpected routing reason");
    });
    client.log(`Customer ${request.iteration() + 1}: ${body?.provider}, reason: ${body?.reason}`);

    if (request.iteration() === request.variables.get("customers").length - 1) {
        client.log(`New: ${counts.newProvider}, legacy: ${counts.legacy}, failed: ${counts.failed}`);
        client.log(`Configured limit: ${body?.newProviderLimitPerSecond} new-provider admissions per rolling second`);
    }
%}
