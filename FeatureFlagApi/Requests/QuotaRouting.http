@baseUrl = http://localhost:5159

### Exact 50/50 quota across a batch of 100 customers
# Run this request after starting the API.
# First 50 IDs receive new-provider slots; remaining IDs use legacy.
# Quotas apply independently to each batch, without feature-flag configuration.
# This previews assignments only; it does not charge payments or persist routing.
< {%
    const customerIds = Array.from({ length: 100 }, (_, index) =>
        `customer-${String(index + 1).padStart(3, "0")}`);
    request.variables.set("customerIdsJson", JSON.stringify(customerIds));
%}
POST {{baseUrl}}/payments/quota-routing-preview
Content-Type: application/json

{
    "customerIds": {{customerIdsJson}},
    "newProviderQuota": 50
}

> {%
    client.test("Quota preview succeeded", () => {
        client.assert(response.status === 200, `Expected HTTP 200, got ${response.status}`);
    });

    if (response.status === 200) {
        const assignments = response.body.assignments;
        const newCount = assignments.filter(item => item.provider === "new").length;
        const legacyCount = assignments.filter(item => item.provider === "legacy").length;

        client.test("Exactly 100 unique customers and a 50/50 split", () => {
            client.assert(assignments.length === 100, "Expected 100 assignments");
            client.assert(new Set(assignments.map(item => item.customerId)).size === 100,
                "Expected unique customers");
            client.assert(newCount === 50, `Expected 50 new, got ${newCount}`);
            client.assert(legacyCount === 50, `Expected 50 legacy, got ${legacyCount}`);
        });

        client.log(`New: ${newCount}, legacy: ${legacyCount}`);
        client.log(`Observed quota: ${(100 * newCount / assignments.length).toFixed(1)}%`);
    }
%}
