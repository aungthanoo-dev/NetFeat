{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "StatusPolicy": "FixedWindow",
    "SubmissionTokenLimit": 5,
    "SubmissionTokensPerPeriod": 1,
    "SubmissionReplenishmentPeriod": "00:00:02",
    "StatusPermitLimit": 10,
    "StatusWindowLength": "00:00:10",
    "StatusSegmentsPerWindow": 5,
    "ExportPermitLimit": 2
  },
  "AllowedHosts": "*"
}
